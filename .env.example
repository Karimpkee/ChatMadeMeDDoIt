# Comma-separated pair addresses from DexScreener (chain: solana)
SOLANA_PAIR_ADDRESSES=HTjR9n...replace_me...,D8fNQ...replace_me...

# Polling cadence
POLL_INTERVAL_SECONDS=45

# Risk/zone thresholds
MIN_LIQUIDITY_USD=50000
LOW_VOLUME_CUTOFF_USD_M5=3000
PRIME_VOLUME_FLOOR_USD_M5=10000
BUY_PRESSURE_THRESHOLD=0.20
MAX_NEGATIVE_CHANGE_M5=-1.25

# Optional alert sink
DISCORD_WEBHOOK_URL=
